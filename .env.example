# GitHub App credentials — required only for live webhook handling.
NEATCODER_GITHUB_APP_ID=
NEATCODER_GITHUB_PRIVATE_KEY_PATH=.secrets/neatcoder-app.pem
# For managed deployments, supply the PEM contents directly (for example, from Secret Manager)
# instead of using the path above. Do not set both unless the path is intentional.
NEATCODER_GITHUB_PRIVATE_KEY=
NEATCODER_WEBHOOK_SECRET=

# Local service settings
NEATCODER_ENVIRONMENT=development
NEATCODER_LOG_LEVEL=INFO
NEATCODER_PORT=8000
NEATCODER_MAX_FILES=100
NEATCODER_MAX_DIFF_BYTES=500000
NEATCODER_MAX_INLINE_COMMENTS=20
